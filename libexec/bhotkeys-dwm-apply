############################################################ IDENT(1)
#
# $Title: Publish dwm key changes on _DWM_KEYS $
# $Copyright: 2026 Devin Teske. All rights reserved. $
# $FrauBSD: bhotkeys/libexec/bhotkeys-dwm-apply 2026-10-20 15:00:34 -0700 Devin Teske $
#
############################################################ INFORMATION
#
# dwm built with RUNTIMEKEYS reads the root-window property
# _DWM_KEYS while it is running.
#
# A listen 0 row is dwm's own binding. Its "# dwm" comment names
# the stock chord and the function. Left on that chord, the
# compiled table keeps it. Turned off, this writes unbind. Moved,
# this writes unbind of the stock chord and bind of the new one.
# A comment that starts with "add" is absent from stock dwm;
# this writes bind only while that row is on.
#
# A listen 1 chord is a grab: dwm takes the key and runs nothing,
# so the focused client does not see it. A chord this script
# bound, or left in the compiled table, is not grabbed.
#
# An empty list removes the property and the compiled table
# returns. Missing dwm is not an error.
#
############################################################ INCLUDES

. "${0%/*}/bhotkeys-prefix.subr" || exit
. "$PREFIX/libexec/bhotkeys/bhotkeys-seq.subr" || exit
. "$PREFIX/libexec/bhotkeys/bhotkeys-plugin.subr" || exit

############################################################ GLOBALS

bh_wm=dwm
bh_tag=dwm

############################################################ FUNCTIONS

dwm_up()
{
	proc_eq dwm
}

emit_grabs()
{
	local __chords="$1" __seen="$2"
	local __id __key __mods __sym

	while IFS='	' read -r __id __key; do
		[ "$__id" ] || continue
		__mods="${__key%%, *}"
		__sym="${__key#*, }"
		[ "$__mods" ] && [ "$__sym" ] || continue
		case "$__mods" in
		*[!0-9A-Za-z_|]*) continue ;;
		esac
		case "$__sym" in
		XK_[A-Za-z0-9_]*) ;;
		*) continue ;;
		esac
		grep -qFx "$__mods $__sym" "$__seen" && continue
		printf '%s\n' "$__mods $__sym" >> "$__seen"
		printf 'grab %s %s\n' "$__mods" "$__sym"
	done < "$__chords"
}

# listen 0: unbind a stock chord, bind a moved one, or add a new one
emit_owned()
{
	local __rows="$1" __seen="$2"

	awk -F '\t' -v seen="$__seen" '
	function okmod(m) {
		return m ~ /^[0-9A-Za-z_|]+$/
	}
	function oksym(s) {
		return s ~ /^XK_[A-Za-z0-9_]+$/
	}
	function note(m, s) {
		print m " " s >> seen
	}
	{
		en = $2
		live = $3
		rest = $4
		if ($1 == "" || rest == "")
			next
		n = split(rest, a, " ")
		if (a[1] == "add") {
			if (en != 1)
				next
			if (split(live, lv, ", ") != 2)
				next
			if (!okmod(lv[1]) || !oksym(lv[2]))
				next
			if (n < 4)
				next
			cmd = "bind " lv[1] " " lv[2]
			for (i = 4; i <= n; i++)
				cmd = cmd " " a[i]
			print cmd
			note(lv[1], lv[2])
			next
		}
		if (n < 3 || !okmod(a[1]) || !oksym(a[2]))
			next
		if (en != 1) {
			print "unbind " a[1] " " a[2]
			next
		}
		if (split(live, lv, ", ") != 2)
			next
		if (!okmod(lv[1]) || !oksym(lv[2]))
			next
		if (lv[1] " " lv[2] == a[1] " " a[2]) {
			note(a[1], a[2])
			next
		}
		print "unbind " a[1] " " a[2]
		cmd = "bind " lv[1] " " lv[2]
		for (i = 3; i <= n; i++)
			cmd = cmd " " a[i]
		print cmd
		note(lv[1], lv[2])
	}
	END {
		close(seen)
	}
	' "$__rows"
}

publish_keys()
{
	local __body="$1"
	local __val

	have xprop || return 0
	[ "$DISPLAY" ] || return 0
	if [ ! -s "$__body" ]; then
		quietly xprop -root -remove _DWM_KEYS
		return 0
	fi
	#
	# Command substitution drops trailing newlines. The last
	# line remains, and dwm accepts a final line with none
	# after it.
	#
	__val=$( cat "$__body" ) || return 0
	xprop -root -f _DWM_KEYS 8s -set _DWM_KEYS "$__val"
}

############################################################ MAIN

case "$1" in
--wait) apply_wait dwm_up || exit 0 ;;
*) dwm_up || exit 0
esac
bh_resolve || exit 0
raw=$( mktemp ) || exit 0
meta=$( mktemp ) || exit 0
owned=$( mktemp ) || exit 0
grabs=$( mktemp ) || exit 0
body=$( mktemp ) || exit 0
seen=$( mktemp ) || exit 0
trap 'rm -f "$raw" "$meta" "$owned" "$grabs" \
	"$body" "$seen"' EXIT
"$BH" --print-keys "$bh_wm" > "$raw" || exit 0
scan_dirs "$meta"
awk -F '\t' '
	NR == FNR {
		if ($1 != "" && $2 != "")
			meta[$1] = $2
		next
	}
	$2 == 0 && ($1 in meta) {
		print $1 "\t" $3 "\t" $4 "\t" meta[$1]
	}
' "$meta" "$raw" > "$owned"
awk -F '\t' '
	$2 == 1 && $3 == 1 { print $1 "\t" $4 }
' "$raw" > "$grabs"
emit_owned "$owned" "$seen" > "$body"
emit_grabs "$grabs" "$seen" >> "$body"
publish_keys "$body"

################################################################################
# END
################################################################################
