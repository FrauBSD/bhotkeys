############################################################ IDENT(1)
#
# $Title: Keep listener chords out of i3 clients $
# $Copyright: 2026 Devin Teske. All rights reserved. $
# $FrauBSD: bhotkeys/libexec/bhotkeys-i3-apply 2026-10-03 18:50:50 -0700 Devin Teske $
#
############################################################ INFORMATION
#
# ~/.config/i3/bhotkeys.i3 is generated from the packaged i3 config
# (/usr/local/etc/i3/config).
#
# A disabled i3 row is left out of that copy, so i3 does not bind the key.
# bhotkeys --print-keys i3 supplies each row's enable and bindsym key.
#
# ~/.config/i3/bhotkeys holds bindsym nop lines for keys the listener handles,
# and is included after bhotkeys.i3. An include of the packaged file is
# switched to those two includes. This script does not add them if you took the
# include out.
#
############################################################ GLOBALS

pgm="${0##*/}" # Program basename

seq_lib="${0%/*}/bhotkeys-seq.subr"
[ -f "$seq_lib" ] || seq_lib="${0%/*}/../../bhotkeys/bhotkeys-seq.subr"
[ -f "$seq_lib" ] || seq_lib=/usr/local/bhotkeys/bhotkeys-seq.subr
[ -f "$seq_lib" ] || exit 0
. "$seq_lib"

plug_lib="${0%/*}/bhotkeys-plugin.subr"
[ -f "$plug_lib" ] || plug_lib="${0%/*}/../../bhotkeys/bhotkeys-plugin.subr"
[ -f "$plug_lib" ] || plug_lib=/usr/local/bhotkeys/bhotkeys-plugin.subr
[ -f "$plug_lib" ] || exit 0
. "$plug_lib"
bh_wm=i3
bh_tag=i3

############################################################ FUNCTIONS

i3_paths()
{
	local __var_dir="$1" __var_cfg="$2" __var_snip="$3"
	local __dir

	if [ ! "$HOME" ]; then
		return 1
	fi
	__dir="$HOME/.config/i3"
	eval $__var_dir=\"\$__dir\"
	eval $__var_cfg=\"\$__dir/config\"
	eval $__var_snip=\"\$__dir/bhotkeys\"
}

off_key()
{
	local __want="$1" __id __en __key __cmd

	while IFS='	' read -r __id __en __key __cmd; do
		[ "$__en" = 0 ] || continue
		[ "$__key" = "$__want" ] && return 0
	done < "$rows"
	return 1
}

append_nops()
{
	local __id __en __bind __list __line

	[ -f "$grabs" ] || return 0
	__list=$( mktemp )
	while IFS='	' read -r __id __en __bind; do
		[ "$__en" = 1 ] || continue
		[ "$__bind" ] || continue
		if [ -s "$bound" ] && grep -F -x -q -- "$__bind" "$bound"; then
			continue
		fi
		printf '%s\n' "$__bind" >> "$__list"
	done < "$grabs"
	if [ -s "$__list" ]; then
		sort -u "$__list" | while IFS= read -r __line; do
			printf 'bindsym %s nop\n' "$__line"
		done
	fi
	rm -f "$__list"
}

install_file()
{
	local __dest="$1" __new="$2"

	if [ -f "$cfgdir/$__dest" ] && cmp -s "$cfgdir/$__dest" "$__new"; then
		rm -f "$__new"
		return 0
	fi
	if [ -f "$cfgdir/$__dest" ]; then
		cp -f "$cfgdir/$__dest" "$cfgdir/$__dest.prev"
	fi
	mv -f "$__new" "$cfgdir/$__dest"
	packaged_changed=1
}

write_packaged()
{
	local __src __line __rest __tok __out

	if [ -f /usr/local/etc/i3/config ]; then
		__src=/usr/local/etc/i3/config
	elif [ -f /etc/i3/config ]; then
		__src=/etc/i3/config
	else
		return 1
	fi
	__out=$cfgdir/bhotkeys.i3.new
	:> "$bound"
	{
		printf '%s\n' '# Generated by bhotkeys-i3-apply.'
		printf '%s\n' "# Source: $__src"
		printf '%s\n' '# A disabled i3 row is omitted so i3 does not bind that key.'
		while IFS= read -r __line || [ "$__line" ]; do
			case "$__line" in
			'bindsym '*|'	bindsym '*)
				__rest=${__line#*bindsym}
				__rest=${__rest# }
				__tok=${__rest%% *}
				while [ "$__tok" ]; do
					case "$__tok" in
					--*)
						__rest=${__rest#"$__tok"}
						__rest=${__rest# }
						__tok=${__rest%% *}
						;;
					*)
						break
						;;
					esac
				done
				if off_key "$__tok"; then
					continue
				fi
				printf '%s\n' "$__tok" >> "$bound"
				;;
			esac
			printf '%s\n' "$__line"
		done < "$__src"
	} > "$__out"
	install_file bhotkeys.i3 "$__out"
}

write_grabs()
{
	local __out

	__out=$cfgdir/bhotkeys.new
	{
		printf '%s\n' '# Generated by bhotkeys-i3-apply.'
		printf '%s\n' '# bindsym nop for keys the listener handles.'
		append_nops
	} > "$__out"
	install_file bhotkeys "$__out"
}

packaged_include()
{
	cat <<'EOF'
# bhotkeys: generated from packaged i3 config. Disabled i3 rows are left out.
include ~/.config/i3/bhotkeys.i3
# bhotkeys: keys the listener handles. nop keeps them from the focused window.
include ~/.config/i3/bhotkeys
EOF
}

ensure_include()
{
	local __line __keep __saw

	[ -f "$cfg" ] || return 0
	__keep=$( mktemp )
	__saw=
	while IFS= read -r __line || [ "$__line" ]; do
		case "$__line" in
		'# bhotkeys:'*) continue ;;
		'include /usr/local/etc/i3/config'|\
		'include /etc/i3/config'|\
		'include ~/.config/i3/packaged'|\
		'include ~/.config/i3/bhotkeys.i3'|\
		'include ~/.config/i3/bhotkeys')
			if [ ! "$__saw" ]; then
				packaged_include >> "$__keep"
				__saw=1
			fi
			continue
			;;
		esac
		printf '%s\n' "$__line" >> "$__keep"
	done < "$cfg"
	if cmp -s "$cfg" "$__keep"; then
		rm -f "$__keep"
		return 0
	fi
	cp -f "$cfg" "$cfgdir/config.prev"
	mv -f "$__keep" "$cfg"
	included=1
}

i3_up()
{
	have i3-msg || return 1
	quietly i3-msg -t get_version
}

config_ok()
{
	local __err

	have i3 || return 0
	__err=$( i3 -C -c "$cfg" 2>&1 ) && return 0
	printf '%s\n' "$__err" | awk '
		/Duplicate keybinding in config file/ { next }
		/state mask .* with keysym / { next }
		/keysym = / { next }
		/^$/ { next }
		{ bad = 1 }
		END { exit bad ? 1 : 0 }
	'
}

reload_i3()
{
	have i3-msg || return 0
	quietly i3-msg reload || : reload
}

############################################################ MAIN

bh_resolve || exit 0
case "$1" in
--wait) apply_wait i3_up || exit 0 ;;
*) : i3 need not be running to write its config
esac
rawk=$( mktemp )
rows=$( mktemp )
rows2=$( mktemp )
grabs=$( mktemp )
bound=$( mktemp )
i3_paths cfgdir cfg snip || exit 0
mkdir -p "$cfgdir" || exit 0
trap 'rm -f "$rawk" "$rows" "$rows2" "$grabs" "$bound" \
	"$cfgdir/bhotkeys.new" "$cfgdir/bhotkeys.i3.new" \
	"$cfgdir/bhotkeys.prev" "$cfgdir/bhotkeys.i3.prev" \
	"$cfgdir/config.prev"' EXIT

"$BH" --print-keys "$bh_wm" > "$rawk" || exit 0
# id, enable, key, command: a listen 0 row joined with its
# "# i3 key command" comment. Those keys are i3's own bindsyms
scan_dirs "$rows"
awk -F '\t' '
	NR == FNR {
		key = $2
		sub(/ .*/, "", key)
		cmd = $2
		sub(/^[^ ]+ */, "", cmd)
		if (key != "")
			meta[$1] = key "\t" cmd
		next
	}
	$2 == 0 && ($1 in meta) { print $1 "\t" $3 "\t" meta[$1] }
' "$rows" "$rawk" > "$rows2"
mv -f "$rows2" "$rows"
# id, enable, bindsym key: a listen 1 row the listener handles
awk -F '\t' '
	$2 == 1 { print $1 "\t" $3 "\t" $4 }
' "$rawk" > "$grabs"

packaged_changed=
included=
write_packaged || exit 0
write_grabs
ensure_include
if config_ok; then
	if [ "$included" ] || [ "$packaged_changed" ]; then
		reload_i3
	fi
	rm -f "$cfgdir/packaged" "$cfgdir/bhotkeys.prev" \
		"$cfgdir/bhotkeys.i3.prev" "$cfgdir/config.prev"
else
	[ -f "$cfgdir/bhotkeys.i3.prev" ] &&
		mv -f "$cfgdir/bhotkeys.i3.prev" "$cfgdir/bhotkeys.i3"
	[ -f "$cfgdir/bhotkeys.prev" ] &&
		mv -f "$cfgdir/bhotkeys.prev" "$cfgdir/bhotkeys"
	[ -f "$cfgdir/config.prev" ] &&
		mv -f "$cfgdir/config.prev" "$cfg"
fi

################################################################################
# END
################################################################################
