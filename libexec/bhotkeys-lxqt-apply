# SPDX-License-Identifier: BSD-2-Clause
#
############################################################ IDENT(1)
#
# $Title: Grab listener chords in LXQt $
# $Copyright: 2026 Devin Teske. All rights reserved. $
# $FrauBSD: bhotkeys/libexec/bhotkeys-lxqt-apply 2026-10-20 15:28:20 -0700 Devin Teske $
#
############################################################ INFORMATION
#
# Grab listener chords in LXQt so the focused client does not see
# them. Each new chord runs true. A shortcut the config already
# names is left alone. The keys daemon is stopped, the file is
# written, then the daemon is started again. Missing lxqt-session
# is not an error.
#
############################################################ INCLUDES

. "${0%/*}/bhotkeys-prefix.subr" || exit
. "$PREFIX/libexec/bhotkeys/bhotkeys-seq.subr" || exit

############################################################ GLOBALS

bh_wm=lxqt

############################################################ FUNCTIONS

lxqt_up()
{
	proc_eq lxqt-session
}

conf_path()
{
	if [ "$XDG_CONFIG_HOME" ]; then
		conf_file="$XDG_CONFIG_HOME/lxqt/globalkeyshortcuts.conf"
	else
		conf_file="$HOME/.config/lxqt/globalkeyshortcuts.conf"
	fi
}

build_want()
{
	local __chords="$1" __id __enc

	while IFS='	' read -r __id __enc; do
		[ "$__id" ] || continue
		grep -qFx "$__enc" "$seen" && continue
		printf '%s\n' "$__enc" >> "$seen"
		printf '%s %s\n' "$__enc" "$__id"
	done < "$__chords"
}

# stdout is the merged config. $1 is the current file, $2 is want
merge_conf()
{
	awk -v want="$2" '
		function trim(s) {
			sub(/^[ \t]+/, "", s)
			sub(/[ \t]+$/, "", s)
			return s
		}
		BEGIN {
			while ((getline line < want) > 0) {
				split(line, a, " ")
				if (a[1] == "" || a[2] == "")
					continue
				n++
				enc[n] = a[1]
				id[n] = a[2]
			}
			close(want)
		}
		{
			t = trim($0)
		}
		t ~ /^\[/ {
			hdr = t
			sub(/^\[/, "", hdr)
			sub(/\]$/, "", hdr)
			if (hdr ~ /\.bhotkeys-[A-Za-z0-9_-]+$/) {
				skip = 1
				next
			}
			skip = 0
			o = hdr
			sub(/\.[^.]*$/, "", o)
			owned[o] = 1
		}
		skip { next }
		{ print }
		END {
			for (i = 1; i <= n; i++) {
				if (owned[enc[i]])
					continue
				print ""
				print "[" enc[i] ".bhotkeys-" id[i] "]"
				print "Comment=bhotkeys"
				print "Enabled=true"
				print "Exec=/usr/bin/true"
			}
		}
	' "$1"
}

seed_conf()
{
	[ -f "$conf_file" ] && return 0
	copy_first "$conf_file" \
		"$LXQT_PREFIX/share/lxqt/globalkeyshortcuts.conf" \
		"$LXQT_PREFIX/etc/xdg/lxqt/globalkeyshortcuts.conf" \
		"$LXQT_PREFIX/share/lxqt/lxqt-globalkeys/globalkeyshortcuts.conf" \
		/usr/share/lxqt/globalkeyshortcuts.conf
}

keysd_pid()
{
	local __me

	__me=$( id -un )
	ps -ax -o pid,user,comm | awk -v u="$__me" '
		$2 == u && $3 == "lxqt-globalkeysd" { print $1; exit }
	'
}

stop_keysd()
{
	local __pid __i

	__pid=$( keysd_pid )
	[ "$__pid" ] || return 0
	kill -TERM "$__pid" 2> /dev/null || : stop failed
	__i=0
	while [ "$__i" -lt 20 ]; do
		__pid=$( keysd_pid )
		[ "$__pid" ] || return 0
		sleep 0.1
		__i=$(( $__i + 1 ))
	done
}

start_keysd()
{
	local __pid

	__pid=$( keysd_pid )
	[ "$__pid" ] && return 0
	have lxqt-globalkeysd || return 0
	/usr/sbin/daemon -f lxqt-globalkeysd || : start failed
}

############################################################ MAIN

case "$1" in
--wait) apply_wait lxqt_up || exit 0 ;;
*) lxqt_up || exit 0
esac
[ "$HOME" ] || exit 0
bh_resolve || exit 0
conf_path
seed_conf || exit 0
[ -f "$conf_file" ] || exit 0
chords=$( mktemp ) || exit 0
want=$( mktemp ) || exit 0
new=$( mktemp ) || exit 0
seen=$( mktemp ) || exit 0
trap 'rm -f "$chords" "$want" "$new" "$seen"' EXIT
chord_file "$chords" || exit 0
build_want "$chords" > "$want"
merge_conf "$conf_file" "$want" > "$new" || exit 0
if cmp -s "$conf_file" "$new"; then
	exit 0
fi
was=$( keysd_pid )
[ "$was" ] && stop_keysd
if ! cat "$new" > "$conf_file"; then
	[ "$was" ] && start_keysd
	exit 0
fi
[ "$was" ] && start_keysd

################################################################################
# END
################################################################################
